---
import BangumiSearch from "../../components/manage/BangumiSearch.astro";
import CollectionForm from "../../components/manage/CollectionForm.astro";
import CollectionManager from "../../components/manage/CollectionManager.astro";
import LoginForm from "../../components/manage/LoginForm.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
---

<MainGridLayout
    title="收藏管理"
    description="管理我的番剧和小说收藏"
>
    <div class="card-base rounded-[var(--radius-large)] p-8 text-neutral-900 dark:text-neutral-100">
        <h1 class="text-2xl font-bold mb-6">收藏管理</h1>

        <LoginForm />

        <BangumiSearch />

        <CollectionForm />

        <CollectionManager />

    </div>
</MainGridLayout>

<script>
    import { initializeLogin } from "../../scripts/manage/auth";
    import {
        loadManagedCollections,
        initializeManageList,
    } from "../../scripts/manage/collection-list";
    import {
        openCollectionEditor,
        initializeEditCollection,
    } from "../../scripts/manage/collection-edit";
    import {
        initializeSaveCollection,
        initializeCollectionForm,
    } from "../../scripts/manage/collection-create";
    import { initializeSearch } from "../../scripts/manage/search";


    function setupLogin() {
        initializeLogin(() => loadManagedCollections(openCollectionEditor));
    }

    document.addEventListener("astro:page-load", setupLogin);
    setupLogin();

    document.addEventListener("astro:page-load", initializeSearch);
    initializeSearch();

    document.addEventListener("astro:page-load", initializeCollectionForm);
    initializeCollectionForm();

    document.addEventListener("astro:page-load", initializeSaveCollection);
    initializeSaveCollection();


    function setupManageList() {
        initializeManageList(openCollectionEditor);
    }

    document.addEventListener("astro:page-load", setupManageList);
    setupManageList();

    function setupEditCollection() {
        initializeEditCollection(
            () => loadManagedCollections(openCollectionEditor)
        );
    }

    document.addEventListener("astro:page-load", setupEditCollection);
    setupEditCollection();

</script>