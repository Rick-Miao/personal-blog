---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
---

<MainGridLayout
    title="收藏管理"
    description="管理我的番剧和小说收藏"
>
    <div class="card-base rounded-[var(--radius-large)] p-8 text-neutral-900 dark:text-neutral-100">
        <h1 class="text-2xl font-bold mb-6">收藏管理</h1>

        <form id="login-form" class="flex flex-col gap-4 max-w-md">
            <div class="flex flex-col gap-2">
                <label for="email">邮箱</label>
                <input
                    id="email"
                    type="email"
                    required
                    autocomplete="username"
                    class="rounded-lg border p-3 text-black"
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="password">密码</label>
                <input
                    id="password"
                    type="password"
                    required
                    autocomplete="current-password"
                    class="rounded-lg border p-3 text-black"
                />
            </div>

            <button type="submit" class="btn-regular rounded-lg p-3">
                登录
            </button>
        </form>

        <p id="login-message" class="mt-4" role="status" aria-live="polite"></p>


        <div class="mt-8 border-t border-[var(--line-divider)] pt-6">
            <h2 class="text-xl font-bold mb-4">搜索 Bangumi 作品</h2>

            <form id="search-form" class="flex flex-col gap-3">
                <select id="search-type" class="rounded-lg p-3 text-black">
                    <option value="2">动画</option>
                    <option value="1">书籍 / 轻小说</option>
                </select>

                <input
                    id="search-keyword"
                    type="search"
                    placeholder="输入作品名称"
                    required
                    class="rounded-lg p-3 text-black"
                />

                <button type="submit" class="btn-regular rounded-lg p-3">
                    搜索作品
                </button>
            </form>

            <p id="search-message" class="mt-4"></p>
            <div id="search-results" class="mt-4 flex flex-col gap-3"></div>

            <section id="collection-editor" class="mt-6 hidden border-t border-[var(--line-divider)] pt-6">
                <h2 class="text-xl font-bold mb-4">添加到我的收藏</h2>

                <p id="selected-work-title" class="font-bold mb-4"></p>

                <form id="collection-form" class="flex flex-col gap-4">
                    <label class="flex flex-col gap-2">
                        收藏状态
                        <select id="collection-status" class="rounded-lg p-3 text-black">
                            <option value="wish">想看 / 想读</option>
                            <option value="in_progress">在看 / 在读</option>
                            <option value="completed">已完成</option>
                            <option value="on_hold">搁置</option>
                            <option value="dropped">弃番 / 弃读</option>
                        </select>
                    </label>

                    <label class="flex flex-col gap-2">
                        个人评分(0 表示暂不评分)
                        <input id="collection-score" type="number"
                            min="0" max="10" step="1" value="0"
                            class="rounded-lg p-3 text-black" />
                    </label>

                    <label class="flex flex-col gap-2">
                        观看集数 / 阅读进度
                        <input id="collection-progress" type="number"
                            min="0" step="1" value="0"
                            class="rounded-lg p-3 text-black" />
                    </label>

                    <label class="flex flex-col gap-2">
                        个人短评
                        <textarea id="collection-comment" rows="3"
                                class="rounded-lg p-3 text-black"></textarea>
                    </label>

                    <label class="flex items-center gap-2">
                        <input id="collection-published" type="checkbox" />
                        公开展示在个人网站
                    </label>

                    <button type="submit" class="btn-regular rounded-lg p-3">
                        预览收藏数据
                    </button>
                </form>

                <pre id="collection-preview" class="mt-4 whitespace-pre-wrap break-all text-sm"></pre>
                <button
                    id="save-collection"
                    type="button"
                    class="btn-regular rounded-lg p-3 mt-4"
                >
                    保存到 PocketBase
                </button>

                <p id="save-message" class="mt-3" role="status" aria-live="polite"></p>
            </section>

            <section
                id="manage-collections"
                class="card-base rounded-[var(--radius-large)] p-6 mt-6 text-neutral-900 dark:text-neutral-100"
            >
                <h2 class="text-xl font-bold mb-4">我的收藏</h2>

                <button
                    id="refresh-collections"
                    type="button"
                    class="btn-regular rounded-lg px-4 py-2 mb-4"
                >
                    刷新收藏
                </button>

                <p id="manage-list-message" role="status"></p>

                <div id="manage-list" class="flex flex-col gap-3 mt-4"></div>

                <section id="edit-collection-panel"
                        class="hidden mt-6 border-t border-[var(--line-divider)] pt-6">
                    <h3 class="text-lg font-bold mb-4">编辑收藏</h3>
                    <p id="edit-work-title" class="mb-4"></p>

                    <form id="edit-collection-form" class="flex flex-col gap-4">
                        <label class="flex flex-col gap-2">
                            收藏状态
                            <select id="edit-status" class="rounded-lg p-3 text-black">
                                <option value="wish">想看 / 想读</option>
                                <option value="in_progress">在看 / 在读</option>
                                <option value="completed">已完成</option>
                                <option value="on_hold">搁置</option>
                                <option value="dropped">弃番 / 弃读</option>
                            </select>
                        </label>

                        <label class="flex flex-col gap-2">
                            评分
                            <input id="edit-score" type="number"
                                min="0" max="10" step="1"
                                class="rounded-lg p-3 text-black" />
                        </label>

                        <label class="flex flex-col gap-2">
                            观看 / 阅读进度
                            <input id="edit-progress" type="number"
                                min="0" step="1"
                                class="rounded-lg p-3 text-black" />
                        </label>

                        <label class="flex flex-col gap-2">
                            个人短评
                            <textarea id="edit-comment" rows="3"
                                    class="rounded-lg p-3 text-black"></textarea>
                        </label>

                        <label class="flex items-center gap-2">
                            <input id="edit-published" type="checkbox" />
                            公开展示
                        </label>

                        <button type="submit" class="btn-regular rounded-lg p-3">
                            保存修改
                        </button>
                    </form>

                    <p id="edit-message" class="mt-3" role="status" aria-live="polite"></p>
                </section>

            </section>

        </div>

    </div>
</MainGridLayout>

<script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("https://api.miaopz.top");

    function initializeLogin() {
        const form = document.querySelector<HTMLFormElement>("#login-form");
        const message = document.querySelector<HTMLElement>("#login-message");

        if (!form || !message || form.dataset.initialized === "true") {
            return;
        }

        form.dataset.initialized = "true";

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const email = form.querySelector<HTMLInputElement>("#email");
            const password = form.querySelector<HTMLInputElement>("#password");

            if (!email || !password) return;

            message.textContent = "正在登录……";

            try {
                const result = await pb.collection("users").authWithPassword(
                    email.value,
                    password.value
                );

                message.textContent = `登录成功：${result.record.name || "管理员"}`;
                form.reset();

                await loadManagedCollections();
            } catch (error) {
                console.error("Login failed:", error);
                message.textContent = "登录失败，请检查账号密码。";
            }
        });
    }

    document.addEventListener("astro:page-load", initializeLogin);
    initializeLogin();

    let selectedWork: any = null;
    function initializeSearch() {
        const form = document.querySelector<HTMLFormElement>("#search-form");
        const results = document.querySelector<HTMLElement>("#search-results");
        const message = document.querySelector<HTMLElement>("#search-message");

        if (!form || !results || !message || form.dataset.initialized) return;

        form.dataset.initialized = "true";

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const keyword = form.querySelector<HTMLInputElement>("#search-keyword");
            const type = form.querySelector<HTMLSelectElement>("#search-type");

            if (!keyword || !type || !keyword.value.trim()) return;

            results.replaceChildren();
            message.textContent = "正在搜索……";

            try {
                const response = await fetch(
                    "https://api.bgm.tv/v0/search/subjects?limit=10",
                    {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            keyword: keyword.value.trim(),
                            sort: "match",
                            filter: { type: [Number(type.value)] }
                        })
                    }
                );

                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const data = await response.json();
                message.textContent = `找到 ${data.data?.length ?? 0} 条结果（当前页）`;

                for (const work of data.data ?? []) {
                    const card = document.createElement("div");
                    card.className = "flex items-center gap-4 rounded-lg p-3 border border-[var(--line-divider)]";

                    const img = document.createElement("img");
                    img.src = work.images?.small || "/favicon.svg";
                    img.alt = work.name_cn || work.name;
                    img.className = "w-16 h-20 object-cover rounded";

                    const info = document.createElement("div");
                    const title = document.createElement("p");
                    title.textContent = work.name_cn || work.name;
                    title.className = "font-bold";

                    const id = document.createElement("p");
                    id.textContent = `Bangumi ID: ${work.id}`;
                    id.className = "text-sm opacity-70";

                    const selectButton = document.createElement("button");
                    selectButton.type = "button";
                    selectButton.textContent = "选择作品";
                    selectButton.className = "btn-regular rounded-lg px-4 py-2 ml-auto";

                    selectButton.addEventListener("click", async () => {
                        message.textContent = "正在获取作品详情……";

                        try {
                            const response = await fetch(
                                `https://api.bgm.tv/v0/subjects/${work.id}`
                            );

                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}`);
                            }

                            const details = await response.json();
                            selectedWork = details;

                            const editor = document.querySelector<HTMLElement>("#collection-editor");
                            const title = document.querySelector<HTMLElement>("#selected-work-title");

                            if (editor && title) {
                                editor.classList.remove("hidden");
                                title.textContent = details.name_cn || details.name;
                            }

                            console.log("[Selected Bangumi Work]", {
                                id: details.id,
                                title: details.name_cn || details.name,
                                cover: details.images?.common,
                                description: details.summary,
                            });

                            message.textContent =
                                `已选择：${details.name_cn || details.name}`;

                        } catch (error) {
                            console.error("[Bangumi Detail]", error);
                            message.textContent = "获取作品详情失败。";
                        }
                    });

                    info.append(title, id);
                    card.append(img, info, selectButton);
                    results.appendChild(card);
                }
            } catch (error) {
                console.error("[Bangumi Search]", error);
                message.textContent = "搜索请求失败, 请查看 Console 错误.";
            }
        });
    }

    document.addEventListener("astro:page-load", initializeSearch);
    initializeSearch();


    function initializeSaveCollection() {
        const button = document.querySelector<HTMLButtonElement>(
            "#save-collection"
        );
        const message = document.querySelector<HTMLElement>(
            "#save-message"
        );

        if (!button || !message || button.dataset.initialized) return;

        button.dataset.initialized = "true";

        button.addEventListener("click", async () => {
            if (!selectedWork) {
                message.textContent = "请先选择 Bangumi 作品.";
                return;
            }

            if (!pb.authStore.isValid || !pb.authStore.record) {
                message.textContent = "请先登录管理账号.";
                return;
            }

            const getField = (id: string) =>
                document.getElementById(id) as HTMLInputElement;

            const searchType = getField("search-type").value;

            const workData = {
                title: selectedWork.name_cn || selectedWork.name,
                type: searchType === "2" ? "anime" : "novel",
                bangumi_id: String(selectedWork.id),
                cover_url: selectedWork.images?.common || "",
                description: selectedWork.summary || "",
            };

            const collectionData = {
                status: getField("collection-status").value,
                score: Number(getField("collection-score").value),
                progress: Number(getField("collection-progress").value),
                comment: getField("collection-comment").value,
                published: getField("collection-published").checked,
            };

            const validStatuses = [
                "wish", "in_progress", "completed", "on_hold", "dropped"
            ];

            if (
                !validStatuses.includes(collectionData.status) ||
                !Number.isInteger(collectionData.score) ||
                collectionData.score < 0 ||
                collectionData.score > 10 ||
                !Number.isInteger(collectionData.progress) ||
                collectionData.progress < 0
            ) {
                message.textContent = "收藏信息无效,请检查评分和进度.";
                return;
            }

            button.disabled = true;
            message.textContent = "正在保存……";

            let workId: string | null = null;
            let workCreated = false;

            try {
                // 1. 查找已有作品
                const existingWorks = await pb.collection("works").getList(1, 1, {
                    filter: pb.filter(
                        "bangumi_id = {:id} && type = {:type}",
                        {
                            id: workData.bangumi_id,
                            type: workData.type
                        }
                    )
                });

                if (existingWorks.items.length > 0) {
                    workId = existingWorks.items[0].id;
                } else {
                    // 2. 创建作品
                    const work = await pb.collection("works").create(workData);
                    workId = work.id;
                    workCreated = true;
                }

                // 3. 检查是否已经收藏
                const existingCollections = await pb
                    .collection("collections")
                    .getList(1, 1, {
                        filter: pb.filter("work = {:workId}", { workId })
                    });

                if (existingCollections.items.length > 0) {
                    message.textContent =
                        "这部作品已经收藏过了, 请不要重复添加.";
                    return;
                }

                // 4. 创建收藏
                await pb.collection("collections").create({
                    ...collectionData,
                    work: workId
                });

                message.textContent = "收藏保存成功!";
                console.log("[Collection Save] Success", {
                    workId,
                    workCreated
                });

            } catch (error) {
                console.error("[Collection Save]", error);

                message.textContent = workCreated
                    ? "收藏保存失败: 作品资料可能已创建, 请检查 PocketBase 后重试."
                    : "保存失败, 请检查登录权限或网络连接.";
            } finally {
                button.disabled = false;
            }
        });
    }


    function initializeCollectionForm() {
        const form = document.querySelector<HTMLFormElement>("#collection-form");
        const preview = document.querySelector<HTMLElement>("#collection-preview");

        if (!form || !preview || form.dataset.initialized) return;

        form.dataset.initialized = "true";

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!selectedWork) {
                preview.textContent = "请先选择作品。";
                return;
            }

            const field = (id: string) =>
                document.getElementById(id) as HTMLInputElement;

            const selectedType =
                (document.getElementById("search-type") as HTMLSelectElement).value;

            const workData = {
                title: selectedWork.name_cn || selectedWork.name,
                type: selectedType === "2" ? "anime" : "novel",
                bangumi_id: String(selectedWork.id),
                cover_url: selectedWork.images?.common || "",
                description: selectedWork.summary || "",
            };

            const collectionData = {
                status: field("collection-status").value,
                score: Number(field("collection-score").value),
                progress: Number(field("collection-progress").value),
                comment: field("collection-comment").value,
                published: field("collection-published").checked,
            };

            preview.textContent = JSON.stringify(
                { workData, collectionData },
                null,
                2
            );

            try {
                if (!pb.authStore.isValid) {
                    preview.textContent += "\n\n请先登录管理账号.";
                    return;
                }

                const existingWorks = await pb.collection("works").getList(1, 1, {
                    filter: pb.filter("bangumi_id = {:id}", {
                        id: workData.bangumi_id,
                    }),
                });

                if (existingWorks.totalItems > 0) {
                    preview.textContent +=
                        "\n\n该作品已经存在于 works 数据库中.";

                    console.log("Existing work:", existingWorks.items[0].id);
                } else {
                    preview.textContent +=
                        "\n\n该作品尚未收录, 可以新增.";
                }
            } catch (error) {
                console.error("[Duplicate Check]", error);
                preview.textContent +=
                    "\n\n重复检测失败, 暂时不能保存.";
            }
        });
    }

    document.addEventListener("astro:page-load", initializeCollectionForm);
    initializeCollectionForm();

    document.addEventListener("astro:page-load", initializeSaveCollection);
    initializeSaveCollection();



    async function loadManagedCollections() {
        const container = document.querySelector<HTMLElement>("#manage-list");
        const message = document.querySelector<HTMLElement>("#manage-list-message");

        if (!container || !message) return;

        if (!pb.authStore.isValid) {
            message.textContent = "请先登录管理账号。";
            container.replaceChildren();
            return;
        }

        message.textContent = "正在读取收藏……";
        container.replaceChildren();

        try {
            const records = await pb.collection("collections").getFullList({
                expand: "work",
                requestKey: null,
            });

            message.textContent = `共 ${records.length} 条收藏`;

            for (const record of records) {
                const work = record.expand?.work;
                if (!work) continue;

                const card = document.createElement("div");
                card.className =
                    "flex items-center gap-4 rounded-lg border border-[var(--line-divider)] p-3";

                const cover = document.createElement("img");
                cover.src = work.cover_url || "/favicon.svg";
                cover.alt = work.title;
                cover.className = "w-16 h-20 object-cover rounded";

                const info = document.createElement("div");
                info.className = "flex-1 min-w-0";

                const title = document.createElement("p");
                title.className = "font-bold";
                title.textContent = work.title;

                const details = document.createElement("p");
                details.className = "text-sm opacity-70";
                details.textContent =
                    `${record.status} · ${record.score}/10 · 进度 ${record.progress}`;

                const visibility = document.createElement("p");
                visibility.className = "text-sm opacity-70";
                visibility.textContent =
                    record.published ? "公开" : "私人";

                const editButton = document.createElement("button");
                editButton.type = "button";
                editButton.className = "btn-regular rounded-lg px-3 py-2";
                editButton.textContent = "编辑";
                editButton.dataset.recordId = record.id;
                editButton.addEventListener("click", () => {
                    openCollectionEditor(record);
                });

                info.append(title, details, visibility);
                card.append(cover, info, editButton);
                container.appendChild(card);
            }
        } catch (error) {
            console.error("[Manage Collections]", error);

            const err = error as {
                status?: number;
                message?: string;
                response?: {
                    message?: string;
                };
            };

            message.textContent =
                `读取收藏失败: HTTP ${err.status ?? "未知"}, ` +
                `${err.response?.message ?? err.message ?? "未知错误"}`;
        }
    }


    let editingCollectionId: string | null = null;

    function openCollectionEditor(record: any) {
        const panel = document.querySelector<HTMLElement>(
            "#edit-collection-panel"
        );

        const title = document.querySelector<HTMLElement>(
            "#edit-work-title"
        );

        const status = document.querySelector<HTMLSelectElement>("#edit-status");
        const score = document.querySelector<HTMLInputElement>("#edit-score");
        const progress = document.querySelector<HTMLInputElement>("#edit-progress");
        const comment = document.querySelector<HTMLTextAreaElement>("#edit-comment");
        const published = document.querySelector<HTMLInputElement>("#edit-published");
        const message = document.querySelector<HTMLElement>("#edit-message");

        if (!panel || !title || !status || !score ||
            !progress || !comment || !published || !message) {
            return;
        }

        editingCollectionId = record.id;

        title.textContent = record.expand?.work?.title ?? "未知作品";
        status.value = record.status;
        score.value = String(record.score ?? 0);
        progress.value = String(record.progress ?? 0);
        comment.value = record.comment ?? "";
        published.checked = record.published === true;

        message.textContent = "";
        panel.classList.remove("hidden");

        panel.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }


    function initializeManageList() {
        const button = document.querySelector<HTMLButtonElement>(
            "#refresh-collections"
        );

        if (!button || button.dataset.initialized) return;

        button.dataset.initialized = "true";

        button.addEventListener("click", () => {
            void loadManagedCollections();
        });

        if (pb.authStore.isValid) {
            void loadManagedCollections();
        }
    }

    document.addEventListener("astro:page-load", initializeManageList);
    initializeManageList();


    function initializeEditCollection() {
        const form = document.querySelector<HTMLFormElement>(
            "#edit-collection-form"
        );

        const message = document.querySelector<HTMLElement>(
            "#edit-message"
        );

        if (!form || !message || form.dataset.initialized) return;

        form.dataset.initialized = "true";

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (!editingCollectionId || !pb.authStore.isValid) {
                message.textContent = "请先登录并选择收藏。";
                return;
            }

            const status = form.querySelector<HTMLSelectElement>("#edit-status");
            const score = form.querySelector<HTMLInputElement>("#edit-score");
            const progress = form.querySelector<HTMLInputElement>("#edit-progress");
            const comment = form.querySelector<HTMLTextAreaElement>("#edit-comment");
            const published = form.querySelector<HTMLInputElement>("#edit-published");
            const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

            if (!status || !score || !progress || !comment || !published || !button) {
                return;
            }

            const scoreValue = Number(score.value);
            const progressValue = Number(progress.value);

            if (!Number.isInteger(scoreValue) || scoreValue < 0 || scoreValue > 10 ||
                !Number.isInteger(progressValue) || progressValue < 0) {
                message.textContent = "评分必须为 0–10 的整数，进度不能为负数。";
                return;
            }

            const data = {
                status: status.value,
                score: scoreValue,
                progress: progressValue,
                comment: comment.value,
                published: published.checked
            };

            button.disabled = true;
            message.textContent = "正在保存修改……";

            try {
                await pb.collection("collections").update(
                    editingCollectionId,
                    data
                );

                message.textContent = "修改保存成功！";

                await loadManagedCollections();

            } catch (error) {
                console.error("[Edit Collection]", error);
                message.textContent = "保存失败，请检查权限或网络。";
            } finally {
                button.disabled = false;
            }
        });
    }

    document.addEventListener("astro:page-load", initializeEditCollection);
    initializeEditCollection();

</script>
