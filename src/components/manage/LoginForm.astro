<form id="login-form" class="flex flex-col gap-4 max-w-md">
    <div class="flex flex-col gap-2">
        <label for="email">邮箱</label>
        <input
            id="email"
            type="email"
            required
            autocomplete="username"
            class="rounded-lg border p-3 text-black"
        />
    </div>

    <div class="flex flex-col gap-2">
        <label for="password">密码</label>
        <input
            id="password"
            type="password"
            required
            autocomplete="current-password"
            class="rounded-lg border p-3 text-black"
        />
    </div>

    <button type="submit" class="btn-regular rounded-lg p-3">
        登录
    </button>
</form>

<p id="login-message" class="mt-4" role="status" aria-live="polite"></p>

<button
    id="logout-button"
    type="button"
    class="!hidden btn-regular rounded-lg px-4 py-2 mt-4"
>
    退出登录
</button>